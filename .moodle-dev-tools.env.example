# Copie para ~/.moodle-dev-tools.env e ajuste para os nomes de container e paths do
# seu ambiente. Sem este arquivo, os scripts usam os valores padrão desta máquina de
# desenvolvimento original (definidos no próprio código) — funcionam, mas apontam
# para os nomes/paths errados em outra máquina.
MDT_MOODLE_ROOT=/path/to/project
MDT_MOODLE_HTML=/path/to/project/html
MDT_MOODLE_PUBLIC=/path/to/project/html/public
MDT_CONTAINER_51=moodle-web-51
MDT_CONTAINER_45=moodle-web-45
MDT_CONTAINER_52=moodle-web-52
